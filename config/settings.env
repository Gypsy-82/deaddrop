# ============================================================
#   The one file you edit.  Guided:  make setup   ·   Apply:  make up
# ============================================================
# Ships with working defaults — you can clone and `make up` without touching this.
# No secrets live here: the obfuscated prefix + signing key are generated at runtime.

# ── Access / TLS ─────────────────────────────────────────────
# localhost      → Caddy's internal self-signed CA (offline; expected browser warning)
# yourdomain.com → automatic Let's Encrypt certificate (needs public DNS + open 80/443)
SITE_ADDRESS=localhost

# Host ports Caddy publishes. If 80/443 are taken, e.g. 8080 / 8443,
# then also share links with:  make share BASE="https://localhost:8443"
HTTP_PORT=80
HTTPS_PORT=443

# ── Mode ─────────────────────────────────────────────────────
# What the served page does:
#   feedback      → visitors leave you messages, stored in SQLite (inward)
#   secure-share  → deliver an encrypted secret; recipient decrypts in-browser (outward)
INDEX_TEMPLATE=feedback

# ── Link lifetime ────────────────────────────────────────────
# Default validity of a minted link. Accepts: 30m, 12h, 7d …
# Override per link:  make share CLIENT="Acme" TTL=2h
DEFAULT_TTL=48h

# Secure-share: passphrase tries before a secret self-destructs (0 attempts left = gone).
MAX_ATTEMPTS=3

# Secure-share: max size (MB) for a shared file (make file). It's decrypted in-browser, so keep
# it modest; raising it much may need a higher PHP memory_limit.
MAX_FILE_MB=25

# ── After submit ─────────────────────────────────────────────
# Where a visitor is sent when they click submit.
# Must be an absolute http(s):// URL. Leave BLANK to stay on the page.
REDIRECT_URL=
